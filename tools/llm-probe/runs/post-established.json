{
  "transcript": [
    {
      "tool": "eligible_targets",
      "input": {
        "caster": "kessa",
        "spell_id": "hold-person",
        "slot_level": 2
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-kessa-r1",
        "narration": "Kessa lifts her hand and speaks the binding words, but the magic finds no humanoid mind to seize—the goblin before her is Fey, and Hold Person has no legal target here. Her turn ends."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-b",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "goblin-b-r1-shortbow-kessa",
        "narration": "The goblin by the bar snarls and snaps up its shortbow, loosing an arrow at Kessa from across the room."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-goblin-b-r1",
        "narration": "The arrow punches into Kessa for 4 piercing damage. The goblin keeps its ground and ends its turn."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-a",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "goblin-a-r1-shortbow-kessa",
        "narration": "The second goblin darts sideways for a clear angle and sends another shortbow shot hissing toward Kessa."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-goblin-a-r1",
        "narration": "The shot strikes true, dealing 4 piercing damage. Kessa is left wounded but still standing as the goblin ends its turn."
      },
      "harness": false
    },
    {
      "tool": "cast_spell",
      "input": {
        "caster": "kessa",
        "spell_id": "fire-bolt",
        "targets": [
          "goblin-b"
        ],
        "command_id": "kessa-r2-fire-bolt-goblin-b",
        "narration": "Both goblins are equally close, so Kessa snaps her aim to the one by the bar that first drew blood. A mote of flame streaks from her hand toward goblin-b."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-kessa-r2",
        "narration": "The flame hits goblin-b squarely, burning it for 5 fire damage. It staggers but remains on its feet. Kessa ends her turn."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-b",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "goblin-b-r2-shortbow-kessa",
        "narration": "Scorched and furious, goblin-b jerks back from the flame and fires another shortbow shot at Kessa."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-goblin-b-r2",
        "narration": "The arrow sinks deep, dealing 8 piercing damage. Kessa reels, badly hurt but still conscious, as goblin-b ends its turn."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-a",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "goblin-a-r2-shortbow-kessa",
        "narration": "Seeing Kessa falter, goblin-a bares its teeth and looses another arrow at her."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-goblin-a-r2",
        "narration": "The arrow clips Kessa for 3 piercing damage. She remains barely standing as goblin-a ends its turn."
      },
      "harness": false
    },
    {
      "tool": "move",
      "input": {
        "who": "kessa",
        "from_landmark": "the bar",
        "feet": 5,
        "bearing": 180,
        "command_id": "kessa-r3-move-to-bar",
        "narration": "Bleeding badly, Kessa staggers back toward the bar, trying to put furniture and distance between herself and the goblins."
      },
      "harness": false
    },
    {
      "tool": "cast_spell",
      "input": {
        "caster": "kessa",
        "spell_id": "fire-bolt",
        "targets": [
          "goblin-b"
        ],
        "command_id": "kessa-r3-fire-bolt-goblin-b",
        "narration": "From beside the bar, Kessa thrusts out a shaking hand and hurls another mote of fire at the already-scorched goblin-b."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-kessa-r3",
        "narration": "The fire bolt strikes goblin-b and burns it down. It collapses dead, leaving one goblin still facing Kessa. Her turn ends."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-goblin-b-r3-dead",
        "narration": "Goblin-b lies dead where the fire bolt dropped it and takes no action. Its turn passes."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-a",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "goblin-a-r3-shortbow-kessa",
        "narration": "The last goblin hisses as its companion falls, then draws a bead on the barely standing Kessa and fires."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "end-goblin-a-r3",
        "narration": "The arrow hits for 4 piercing damage. Kessa drops to the floor, unconscious and prone, as the last goblin ends its turn."
      },
      "harness": false
    }
  ],
