{
  "transcript": [
    {
      "tool": "eligible_targets",
      "input": {
        "caster": "kessa",
        "spell_id": "hold-person",
        "slot_level": 2
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r1-kessa-end-after-invalid-hold",
        "narration": "Kessa raises her hand and reaches for the binding words of Hold Person, but the magic finds no Humanoid mind to seize—the goblin before her is Fey, and the spell cannot take hold."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-b",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "r1-goblin-b-shortbow-kessa",
        "narration": "The nearer goblin bares needle teeth, snaps up its shortbow, and looses an arrow at Kessa from across the room."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r1-goblin-b-end",
        "narration": "The arrow punches through Kessa's guard and draws blood. The goblin stays where it is, cackling behind the shot."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-a",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "r1-goblin-a-shortbow-kessa",
        "narration": "The second goblin darts sideways for a clearer angle, then draws and fires its own shortbow at Kessa."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r1-goblin-a-end",
        "narration": "The shot lands as well, leaving Kessa bloodied by a second arrow while both goblins keep their distance."
      },
      "harness": false
    },
    {
      "tool": "cast_spell",
      "input": {
        "caster": "kessa",
        "spell_id": "fire-bolt",
        "targets": [
          "goblin-b"
        ],
        "command_id": "r2-kessa-fire-bolt-goblin-b",
        "narration": "Both goblins are equally near; Kessa snaps her hand toward the one directly before her and hurls a bright mote of flame at it."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r2-kessa-end",
        "narration": "The flame strikes true, scorching the goblin and leaving it badly singed but still on its feet."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-b",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "r2-goblin-b-shortbow-kessa",
        "narration": "Smoke curls from the goblin's scorched jerkin. With a furious yelp, it nocks another arrow and fires back at Kessa."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r2-goblin-b-end",
        "narration": "The arrow hits hard. Kessa staggers, badly wounded, while the burned goblin keeps its bow trained on her."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-a",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "r2-goblin-a-shortbow-kessa",
        "narration": "Seeing Kessa reeling, the other goblin gives a shrill laugh, draws its shortbow, and sends another arrow at her."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r2-goblin-a-end",
        "narration": "The arrow bites in. Kessa remains standing by sheer grit, barely clinging to consciousness as the round ends."
      },
      "harness": false
    },
    {
      "tool": "move",
      "input": {
        "who": "kessa",
        "from_landmark": "the bar",
        "feet": 5,
        "bearing": 180,
        "command_id": "r3-kessa-move-to-bar",
        "narration": "Kessa, pale and bleeding, backs toward the bar, putting the heavy wood close at her side as she tries to keep the goblins in view."
      },
      "harness": false
    },
    {
      "tool": "cast_spell",
      "input": {
        "caster": "kessa",
        "spell_id": "fire-bolt",
        "targets": [
          "goblin-b"
        ],
        "command_id": "r3-kessa-fire-bolt-goblin-b",
        "narration": "From beside the bar, Kessa gathers another spark in her palm and flings it at the already-scorched goblin."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r3-kessa-end",
        "narration": "The bolt of fire hits squarely. The scorched goblin collapses in a smoking heap, leaving only one goblin still standing."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r3-goblin-b-dead-end",
        "narration": "The fallen goblin does not move; its turn passes with only smoke curling from its burned body."
      },
      "harness": false
    },
    {
      "tool": "attack",
      "input": {
        "attacker": "goblin-a",
        "target": "kessa",
        "weapon": "shortbow",
        "command_id": "r3-goblin-a-shortbow-kessa",
        "narration": "The last goblin sees Kessa barely standing beside the bar. It hisses, lifts its shortbow, and fires at her heart."
      },
      "harness": false
    },
    {
      "tool": "end_turn",
      "input": {
        "command_id": "r3-goblin-a-end",
        "narration": "The arrow strikes home. Kessa drops beside the bar, unconscious and prone, while the surviving goblin lowers its bow with a triumphant chitter."
      },
      "harness": false
    }
  ],
